# Copy to .env and fill in ONE provider; `make cli` reads it. The app also
# asks for a provider and its key on first start, and saves them under
# ~/.void/config.json — so this file is a convenience, not a requirement.

# ── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenAI-compatible ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL=gpt-6-luna
# How hard the model reasons: none (not at all), low … max. Unset, or a level the
# model does not take, is its default in the catalogue — never none. Set here, it
# outranks what /model's ← → saved, as every variable here does.
# OPENAI_REASONING_EFFORT=medium

# ── Ollama (no key) ──────────────────────────────────────────────────────
# What is installed is listed by /model; these only pick one at start.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
